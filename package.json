{
  "name": "dsh-goal-autopilot",
  "version": "0.3.0-rc.7",
  "description": "Goal-workflow adapter for DeepSeek Harness (dsh): role delegation with explicit model and effort, an independent cross-family review, and a small delegation ledger shown on a session card, as an out-of-tree plugin bundle.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/My-Denia/dsh-autopilot-public.git"
  },
  "homepage": "https://github.com/My-Denia/dsh-autopilot-public",
  "bugs": {
    "url": "https://github.com/My-Denia/dsh-autopilot-public/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "goal",
    "autopilot",
    "goal-workflow",
    "subagent-delegation"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "examples",
    "skill",
    "DESIGN.md",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/check-client-types.mjs && tsc -p tsconfig.client.local.json && node scripts/wrap-client.mjs --id dsh-goal-autopilot --in build --entry client/index.js --out lib/client.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "check:client": "node scripts/check-client-types.mjs && tsc -p tsconfig.client.local.json --noEmit",
    "check:mutation": "stryker run",
    "test": "vitest run",
    "test:client-bundle": "node scripts/run-bundle.mjs lib/client.js dsh-goal-autopilot"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  }
}
